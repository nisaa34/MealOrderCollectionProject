<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>University Cafeteria - Meal Collection Application</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body class="bg-light text-dark m-0" style="font-size: 16px;">
    <div class="container text-start mt-4">
        <h1 class="text-primary mb-4">University Cafeteria Meal Collection System</h1>

         @*RenderBody(): Renders the content of specific view pages (Index, List, Collect, Details) -->*@
        @RenderBody()
    </div>

<!-- Footer section -->
    <footer class="bg-dark text-white text-center py-3 mt-5">
        @if(IsSectionDefined("footer")){
            @RenderSection("footer", required: false)
        } else {
            <p class="mb-0">Web Programming Project</p>
        }
    </footer>
</body>
</html>