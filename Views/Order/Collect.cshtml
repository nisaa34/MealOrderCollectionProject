@model MealOrder

<h2>Meal Collection Page</h2>
<p>Please enter your Order ID (e.g. O001) to mark your meal as collected:</p>

<form asp-action="Collect" method="post" class="mt-3" style="max-width: 400px;">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    
    <div class="mb-3">
        <label for="orderID" class="form-label">Order ID:</label>
        <input type="text" id="orderID" name="orderID" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary">Confirm Collection</button>
    <a href="/Home/Index" class="btn btn-secondary ms-2">Back to Home</a>
</form>